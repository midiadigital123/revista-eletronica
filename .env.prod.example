# .env de PRODUÇÃO (D-214). Copie para `.env` na raiz do repositório, no servidor, e preencha.
# Lido pelo docker-compose.prod.yml. Nunca versione o .env preenchido.
# Subir: docker compose -f docker-compose.prod.yml up --build -d

# --- Obrigatórias (o compose recusa subir sem elas) ---

# Senha do PostgreSQL. Só letras e números: ela entra no DATABASE_URL.
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave do Django (sessões, CSRF, tokens). Trocar desloga todo mundo.
# Gere com: openssl rand -hex 32
DJANGO_SECRET_KEY=

# Domínio(s) do sistema, sem https://, separados por vírgula.
DJANGO_ALLOWED_HOSTS=revista.exemplo.org

# Mesmo(s) domínio(s), COM https://. Sem isto, todo login e formulário dá 403.
DJANGO_CSRF_TRUSTED_ORIGINS=https://revista.exemplo.org

# --- Opcionais ---

# Porta em 127.0.0.1 para o proxy reverso. Padrão: 8000
# APP_PORT=8000

# PostgreSQL gerenciado (fora desta VM): defina e remova o serviço db do compose.
# Padrão: postgres://revista:${POSTGRES_PASSWORD}@db:5432/revista
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Cookies só por HTTPS. Padrão: 1. Use 0 só para testar sem HTTPS.
# DJANGO_COOKIE_SECURE=1
