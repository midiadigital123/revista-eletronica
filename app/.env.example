# Variáveis do app Django. O docker compose lê o .env da RAIZ do repositório.
# Todas têm default de desenvolvimento local; preencha só para sobrescrever.

# Senha do usuário "revista" no serviço db (postgres:17). Default: revista
POSTGRES_PASSWORD=
# Conexão do Django. Default: postgres://revista:${POSTGRES_PASSWORD}@db:5432/revista
DATABASE_URL=
# Chave do Django. O default só serve para desenvolvimento.
DJANGO_SECRET_KEY=
# 1 liga o modo debug (default), 0 desliga.
DJANGO_DEBUG=
# Hosts aceitos, separados por vírgula. Default: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=

# Superusuário: passe só na hora do comando, nunca grave aqui.
#   docker compose run --rm -e DJANGO_SUPERUSER_USERNAME=admin \
#     -e DJANGO_SUPERUSER_EMAIL=admin@exemplo.org -e DJANGO_SUPERUSER_PASSWORD=... \
#     app python manage.py createsuperuser --noinput
